<mxfile host="Electron" agent="netflix-hld-generator">
  <diagram name="Requirements &amp; Capacity Planning" id="requirements--capacity-planning">
    <mxGraphModel dx="3213" dy="2523" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2400" pageHeight="1300" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="n0bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0a0a12;gradientColor=#12121c;gradientDirection=south;strokeColor=none;" value="" vertex="1"><mxGeometry height="1300" width="2400" as="geometry" /></mxCell>
        <mxCell id="topbar" parent="1" style="rounded=0;html=1;fillColor=#e50914;strokeColor=none;" value="" vertex="1"><mxGeometry height="6" width="2400" as="geometry" /></mxCell>
        <mxCell id="t1" parent="1" style="text;html=1;fontColor=#ffffff;fontSize=28;align=left;valign=middle;fontStyle=1;" value="Netflix — Requirements &amp; Capacity Planning" vertex="1"><mxGeometry height="42" width="1400" x="60" y="28" as="geometry" /></mxCell>
        <mxCell id="ts2" parent="1" style="text;html=1;fontColor=#9a9aac;fontSize=13;align=left;valign=middle;" value="Functional &amp; non-functional scope, constraints, and back-of-envelope capacity estimates" vertex="1"><mxGeometry height="24" width="1600" x="62" y="70" as="geometry" /></mxCell>
        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Functional Requirements" vertex="1"><mxGeometry height="44" width="760.0" x="40" y="130" as="geometry" /></mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;Account &amp; Profile&lt;/b&gt;&lt;br&gt;• Sign up / login (email, SSO, mobile)&lt;br&gt;• Multi-profile accounts (up to 5 per household)&lt;br&gt;• Parental controls &amp; content maturity ratings&lt;br&gt;&lt;br&gt;&lt;b&gt;Discovery&lt;/b&gt;&lt;br&gt;• Browse catalog by genre / row-based UI&lt;br&gt;• Full-text &amp; fuzzy search across titles/actors&lt;br&gt;• Personalized recommendation rows&lt;br&gt;&lt;br&gt;&lt;b&gt;Playback&lt;/b&gt;&lt;br&gt;• Adaptive-bitrate streaming (HLS/DASH)&lt;br&gt;• Resume playback across devices (cross-device state)&lt;br&gt;• Multi-audio / subtitle tracks&lt;br&gt;• Offline downloads with license expiry" vertex="1"><mxGeometry height="330" width="760.0" x="40" y="182" as="geometry" /></mxCell>
        <mxCell id="h5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Engagement Features" vertex="1"><mxGeometry height="44" width="760.0" x="40" y="528" as="geometry" /></mxCell>
        <mxCell id="b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Ratings &amp; thumbs up/down feedback&lt;br&gt;• Reviews and &quot;My List&quot; bookmarking&lt;br&gt;• Continue-watching &amp; watch-history sync&lt;br&gt;• Push / email notifications for new releases" vertex="1"><mxGeometry height="150" width="760.0" x="40" y="580" as="geometry" /></mxCell>
        <mxCell id="h7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a0a;strokeColor=#e0a030;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Non-Functional Requirements" vertex="1"><mxGeometry height="44" width="760.0" x="820.0" y="130" as="geometry" /></mxCell>
        <mxCell id="b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2c14;strokeColor=#e0a030;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;Availability&lt;/b&gt;&lt;br&gt;• 99.99% uptime for playback path (core revenue path)&lt;br&gt;• Graceful degradation over hard failure&lt;br&gt;&lt;br&gt;&lt;b&gt;Scalability&lt;/b&gt;&lt;br&gt;• Horizontally scalable stateless services&lt;br&gt;• Elastic autoscaling for regional traffic spikes&lt;br&gt;&lt;br&gt;&lt;b&gt;Latency&lt;/b&gt;&lt;br&gt;• Video start (Time-To-First-Frame) &lt; 2s p95&lt;br&gt;• Search / catalog API &lt; 150ms p95&lt;br&gt;&lt;br&gt;&lt;b&gt;Durability &amp; Consistency&lt;/b&gt;&lt;br&gt;• Zero data loss for billing / entitlements&lt;br&gt;• Eventual consistency acceptable for view counts &amp; recs" vertex="1"><mxGeometry height="330" width="760.0" x="820.0" y="182" as="geometry" /></mxCell>
        <mxCell id="h9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a0a;strokeColor=#e0a030;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Security &amp; Cost" vertex="1"><mxGeometry height="44" width="760.0" x="820.0" y="528" as="geometry" /></mxCell>
        <mxCell id="b10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2c14;strokeColor=#e0a030;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• DRM (Widevine/FairPlay/PlayReady) content protection&lt;br&gt;• TLS everywhere, tokenized signed playback URLs&lt;br&gt;• PCI-DSS compliant billing subsystem&lt;br&gt;• Cost-efficient storage tiering (hot/warm/cold)" vertex="1"><mxGeometry height="150" width="760.0" x="820.0" y="580" as="geometry" /></mxCell>
        <mxCell id="h11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#4caf50;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Additional Functionalities" vertex="1"><mxGeometry height="44" width="760.0" x="1600.0" y="130" as="geometry" /></mxCell>
        <mxCell id="b12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a1f;strokeColor=#4caf50;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;In scope (extended)&lt;/b&gt;&lt;br&gt;• A/B testing framework for UI/algorithm rollout&lt;br&gt;• Content licensing &amp; regional availability windows&lt;br&gt;• Admin/studio content ingestion portal&lt;br&gt;• Real-time analytics dashboards for engagement&lt;br&gt;• Chaos engineering / resilience testing (e.g. Chaos Monkey)&lt;br&gt;&lt;br&gt;&lt;b&gt;Out of scope for this HLD&lt;/b&gt;&lt;br&gt;• Live sports/events streaming specifics&lt;br&gt;• Game-streaming (cloud gaming) subsystem&lt;br&gt;• Detailed ML model architecture internals" vertex="1"><mxGeometry height="330" width="760.0" x="1600.0" y="182" as="geometry" /></mxCell>
        <mxCell id="h13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#4caf50;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Key Assumptions" vertex="1"><mxGeometry height="44" width="760.0" x="1600.0" y="528" as="geometry" /></mxCell>
        <mxCell id="b14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a1f;strokeColor=#4caf50;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Global service across 190+ countries&lt;br&gt;• Content pre-encoded (VOD), not live transcoding&lt;br&gt;• Read-heavy workload (catalog/search &gt;&gt; writes)&lt;br&gt;• Most bytes served via edge CDN, not origin" vertex="1"><mxGeometry height="150" width="760.0" x="1600.0" y="580" as="geometry" /></mxCell>
        <mxCell id="h15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1030;strokeColor=#b060d0;fontColor=#ffffff;fontSize=15;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Capacity Planning — Back-of-the-Envelope Estimates  (illustrative, order-of-magnitude)" vertex="1"><mxGeometry height="46" width="2320" x="40" y="770" as="geometry" /></mxCell>
        <mxCell id="note16" parent="1" style="text;html=1;fontColor=#7a7a8c;fontSize=11;align=left;valign=top;fontStyle=2;" value="All figures below are simplifying assumptions for design purposes, not real Netflix metrics." vertex="1"><mxGeometry height="20" width="2320" x="40" y="820" as="geometry" /></mxCell>
        <mxCell id="h17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=13;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Traffic Assumptions" vertex="1"><mxGeometry height="44" width="448.0" x="40" y="848" as="geometry" /></mxCell>
        <mxCell id="b18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Registered users: 260M&lt;br&gt;• Daily active users (DAU): 130M (50%)&lt;br&gt;• Avg watch time/user/day: 2 hrs&lt;br&gt;• Avg peak concurrency: ~8% of DAU&lt;br&gt;• Avg bitrate (blended): 5 Mbps" vertex="1"><mxGeometry height="248" width="448.0" x="40" y="900" as="geometry" /></mxCell>
        <mxCell id="h19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=13;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Peak Concurrency" vertex="1"><mxGeometry height="44" width="448.0" x="508.0" y="848" as="geometry" /></mxCell>
        <mxCell id="b20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="Peak concurrent streams ≈&lt;br&gt;130M × 8% ≈ &lt;b&gt;10M streams&lt;/b&gt;&lt;br&gt;&lt;br&gt;Playback-start requests ≈&lt;br&gt;10M / (avg 40 min session) ≈&lt;br&gt;&lt;b&gt;~4,200 starts/sec&lt;/b&gt;" vertex="1"><mxGeometry height="248" width="448.0" x="508.0" y="900" as="geometry" /></mxCell>
        <mxCell id="h21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a0a;strokeColor=#e0a030;fontColor=#ffffff;fontSize=13;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Bandwidth (Egress)" vertex="1"><mxGeometry height="44" width="448.0" x="976.0" y="848" as="geometry" /></mxCell>
        <mxCell id="b22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2c14;strokeColor=#e0a030;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="Peak egress ≈&lt;br&gt;10M streams × 5 Mbps ≈&lt;br&gt;&lt;b&gt;~50 Tbps&lt;/b&gt; at global peak&lt;br&gt;&lt;br&gt;&gt;90% served from Open Connect&lt;br&gt;edge caches (ISP-embedded),&lt;br&gt;not origin infrastructure" vertex="1"><mxGeometry height="248" width="448.0" x="976.0" y="900" as="geometry" /></mxCell>
        <mxCell id="h23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#4caf50;fontColor=#ffffff;fontSize=13;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Storage — Content" vertex="1"><mxGeometry height="44" width="448.0" x="1444.0" y="848" as="geometry" /></mxCell>
        <mxCell id="b24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1f3a1f;strokeColor=#4caf50;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="Catalog: ~15,000 titles&lt;br&gt;Master (mezzanine): 2GB × 15K&lt;br&gt;≈ &lt;b&gt;30 TB&lt;/b&gt; masters&lt;br&gt;&lt;br&gt;Encoded (5 bitrate profiles ×&lt;br&gt;~3GB avg): 15K × 5 × 3GB&lt;br&gt;≈ 225TB ×3 (multi-region)&lt;br&gt;≈ &lt;b&gt;~675 TB&lt;/b&gt; encoded, replicated" vertex="1"><mxGeometry height="248" width="448.0" x="1444.0" y="900" as="geometry" /></mxCell>
        <mxCell id="h25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1030;strokeColor=#b060d0;fontColor=#ffffff;fontSize=13;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Storage — Metadata &amp; QPS" vertex="1"><mxGeometry height="44" width="448.0" x="1912.0" y="848" as="geometry" /></mxCell>
        <mxCell id="b26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2f1436;strokeColor=#b060d0;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="User/profile records: 260M ×&lt;br&gt;2KB ≈ &lt;b&gt;~520 GB&lt;/b&gt;&lt;br&gt;&lt;br&gt;Watch-history events: 130M ×&lt;br&gt;50/day × 200B × 365 ≈&lt;br&gt;&lt;b&gt;~475 TB/yr&lt;/b&gt; (Cassandra, TTL&#x27;d)&lt;br&gt;&lt;br&gt;Read:Write ratio ≈ &lt;b&gt;1000:1&lt;/b&gt;&lt;br&gt;Metadata API QPS (peak) ≈&lt;br&gt;&lt;b&gt;~500K QPS&lt;/b&gt;" vertex="1"><mxGeometry height="248" width="448.0" x="1912.0" y="900" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
