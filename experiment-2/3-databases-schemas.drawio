        <mxCell id="ts2" parent="1" style="text;html=1;fontColor=#9a9aac;fontSize=13;align=left;valign=middle;" value="Storage engines, table/column layout, partition &amp; index strategy per data domain" vertex="1"><mxGeometry height="24" width="1600" x="62" y="70" as="geometry" /></mxCell>
        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Users &amp; Billing — PostgreSQL / MySQL (relational, strong consistency)" vertex="1"><mxGeometry height="44" width="760.0" x="40" y="130" as="geometry" /></mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;&lt;tt&gt;user_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;email&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;VARCHAR(255)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;password_hash&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;VARCHAR(255)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;country&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;CHAR(2)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;created_at&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TIMESTAMP&lt;/span&gt;&lt;br&gt;&lt;tt&gt;status&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;ENUM&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: user_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4d84c9&quot;&gt;Index: UNIQUE(email)&lt;/span&gt;
&lt;br&gt;
&lt;b&gt;profiles&lt;/b&gt;&lt;br&gt;&lt;tt&gt;profile_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;user_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — FK → users&lt;/span&gt;&lt;br&gt;&lt;tt&gt;name&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;VARCHAR(50)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;avatar_url&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TEXT&lt;/span&gt;&lt;br&gt;&lt;tt&gt;maturity_level&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;SMALLINT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: profile_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4d84c9&quot;&gt;Index: user_id&lt;/span&gt;
&lt;br&gt;
&lt;b&gt;subscriptions&lt;/b&gt;&lt;br&gt;&lt;tt&gt;sub_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;user_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — FK&lt;/span&gt;&lt;br&gt;&lt;tt&gt;plan_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;VARCHAR(20)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;status&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;ENUM&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — active/paused/cancelled&lt;/span&gt;&lt;br&gt;&lt;tt&gt;renews_at&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TIMESTAMP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: sub_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4d84c9&quot;&gt;Index: user_id&lt;/span&gt;
&lt;br&gt;
&lt;b&gt;payments&lt;/b&gt;&lt;br&gt;&lt;tt&gt;payment_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;user_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — FK&lt;/span&gt;&lt;br&gt;&lt;tt&gt;amount&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;DECIMAL(10,2)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;provider&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;VARCHAR(20)&lt;/span&gt;&lt;br&gt;&lt;tt&gt;status&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;ENUM&lt;/span&gt;&lt;br&gt;&lt;tt&gt;paid_at&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TIMESTAMP&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: payment_id&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4d84c9&quot;&gt;Index: user_id, paid_at&lt;/span&gt;" vertex="1"><mxGeometry height="864" width="760.0" x="40" y="182" as="geometry" /></mxCell>
        <mxCell id="h5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Sharding Strategy" vertex="1"><mxGeometry height="44" width="760.0" x="40" y="1072" as="geometry" /></mxCell>
        <mxCell id="b6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Sharded by &lt;tt&gt;user_id&lt;/tt&gt; hash across regional clusters&lt;br&gt;• Read replicas per region for low-latency reads&lt;br&gt;• Synchronous replication for payments (durability)&lt;br&gt;• Async replication for profile/user reads&lt;br&gt;• PCI-scoped payments schema isolated from core DB" vertex="1"><mxGeometry height="168" width="760.0" x="40" y="1124" as="geometry" /></mxCell>
        <mxCell id="h7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#4caf50;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Catalog &amp; Watch History — Cassandra (wide-column, high write throughput)" vertex="1"><mxGeometry height="44" width="760.0" x="820.0" y="130" as="geometry" /></mxCell>
        <mxCell id="b8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4caf50;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;titles&lt;/b&gt;&lt;br&gt;&lt;tt&gt;title_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;name&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TEXT&lt;/span&gt;&lt;br&gt;&lt;tt&gt;genre&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;SET&lt;TEXT&gt;&lt;/span&gt;&lt;br&gt;&lt;tt&gt;cast&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;LIST&lt;TEXT&gt;&lt;/span&gt;&lt;br&gt;&lt;tt&gt;release_year&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;INT&lt;/span&gt;&lt;br&gt;&lt;tt&gt;regions_available&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;SET&lt;TEXT&gt;&lt;/span&gt;&lt;br&gt;&lt;tt&gt;maturity_rating&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TEXT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: title_id (partition key)&lt;/span&gt;
&lt;br&gt;
&lt;b&gt;episodes&lt;/b&gt;&lt;br&gt;&lt;tt&gt;title_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — partition key&lt;/span&gt;&lt;br&gt;&lt;tt&gt;season_num&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;INT&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — clustering&lt;/span&gt;&lt;br&gt;&lt;tt&gt;episode_num&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;INT&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — clustering&lt;/span&gt;&lt;br&gt;&lt;tt&gt;duration_sec&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;INT&lt;/span&gt;&lt;br&gt;&lt;tt&gt;video_asset_ref&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TEXT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: (title_id, season_num, episode_num)&lt;/span&gt;
&lt;br&gt;
&lt;b&gt;watch_history&lt;/b&gt;&lt;br&gt;&lt;tt&gt;profile_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — partition key&lt;/span&gt;&lt;br&gt;&lt;tt&gt;watched_at&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TIMESTAMP&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — clustering, DESC&lt;/span&gt;&lt;br&gt;&lt;tt&gt;title_id&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;UUID&lt;/span&gt;&lt;br&gt;&lt;tt&gt;progress_sec&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;INT&lt;/span&gt;&lt;br&gt;&lt;tt&gt;device&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;TEXT&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4caf50&quot;&gt;PK: (profile_id, watched_at)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#4d84c9&quot;&gt;Index: TTL 2 years&lt;/span&gt;" vertex="1"><mxGeometry height="624" width="760.0" x="820.0" y="182" as="geometry" /></mxCell>
        <mxCell id="h9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Search Index — Elasticsearch" vertex="1"><mxGeometry height="44" width="760.0" x="820.0" y="832" as="geometry" /></mxCell>
        <mxCell id="b10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;titles_index&lt;/b&gt; mapping:&lt;br&gt;&lt;tt&gt;title (text, analyzed)&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — fuzzy match&lt;/span&gt;&lt;br&gt;&lt;tt&gt;genre (keyword)&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — facet filter&lt;/span&gt;&lt;br&gt;&lt;tt&gt;actors (text[])&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — boosted field&lt;/span&gt;&lt;br&gt;&lt;tt&gt;keywords/tags (text[])&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;&lt;/span&gt;&lt;br&gt;&lt;tt&gt;popularity_score (float)&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — relevance boost&lt;/span&gt;&lt;br&gt;• Sharded by title_id hash, 5 shards × 2 replicas&lt;br&gt;• Re-indexed incrementally on catalog publish events" vertex="1"><mxGeometry height="240" width="760.0" x="820.0" y="884" as="geometry" /></mxCell>
        <mxCell id="h11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a0a;strokeColor=#e0a030;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Cache — Redis / EVCache" vertex="1"><mxGeometry height="44" width="760.0" x="1600.0" y="130" as="geometry" /></mxCell>
        <mxCell id="b12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#e0a030;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;Key patterns &amp; TTL&lt;/b&gt;&lt;br&gt;&lt;tt&gt;session:{userId}&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;hash&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — TTL 24h&lt;/span&gt;&lt;br&gt;&lt;tt&gt;profile_meta:{profileId}&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;hash&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — TTL 6h&lt;/span&gt;&lt;br&gt;&lt;tt&gt;hot_title:{titleId}&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;json&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — TTL 1h, LRU&lt;/span&gt;&lt;br&gt;&lt;tt&gt;resume:{profileId}:{titleId}&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;string&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — TTL 90d&lt;/span&gt;&lt;br&gt;&lt;tt&gt;rec_cache:{profileId}&lt;/tt&gt; &lt;span style=&quot;color:#e0a030&quot;&gt;list&lt;/span&gt;&lt;span style=&quot;color:#9a9aac&quot;&gt; — TTL 30m&lt;/span&gt;&lt;br&gt;&lt;br&gt;• Consistent hashing across cache cluster&lt;br&gt;• Target cache-hit ratio ≥ 90% for hot metadata&lt;br&gt;• Write-through on profile/session updates" vertex="1"><mxGeometry height="288" width="760.0" x="1600.0" y="182" as="geometry" /></mxCell>
        <mxCell id="h13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2a1030;strokeColor=#b060d0;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Video Object Storage — S3 (blob store)" vertex="1"><mxGeometry height="44" width="760.0" x="1600.0" y="496" as="geometry" /></mxCell>
        <mxCell id="b14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#b060d0;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;b&gt;Object key layout&lt;/b&gt;&lt;br&gt;&lt;tt&gt;/content/{titleId}/{profile}/segment-{n}.ts&lt;/tt&gt;&lt;br&gt;&lt;br&gt;• Multi-bitrate HLS/DASH chunks (240p–4K)&lt;br&gt;• Immutable, content-addressed, versioned&lt;br&gt;• Lifecycle policy: hot → infrequent-access tiering&lt;br&gt;• Cross-region replication for DR&lt;br&gt;• Origin for Open Connect CDN cache-fill" vertex="1"><mxGeometry height="240" width="760.0" x="1600.0" y="548" as="geometry" /></mxCell>
        <mxCell id="h15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a3a1a;strokeColor=#4caf50;fontColor=#ffffff;fontSize=12;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Data Lake — S3 + Hive/Presto" vertex="1"><mxGeometry height="44" width="760.0" x="1600.0" y="814" as="geometry" /></mxCell>
        <mxCell id="b16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4caf50;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Raw event logs (Kafka sink) partitioned by date/event-type&lt;br&gt;• Parquet/ORC columnar format for analytics&lt;br&gt;• Hive metastore for schema-on-read&lt;br&gt;• Feeds Spark/Flink jobs &amp; ML training pipelines" vertex="1"><mxGeometry height="144" width="760.0" x="1600.0" y="866" as="geometry" /></mxCell>
