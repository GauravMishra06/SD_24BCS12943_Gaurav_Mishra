        <mxCell id="nonfunch" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#3a2a0a;strokeColor=#e0a030;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Non-Functional Requirements" vertex="1">
          <mxGeometry height="42" width="615" x="715" y="146" as="geometry" />
