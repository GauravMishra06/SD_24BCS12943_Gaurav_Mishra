        <mxCell id="nonfuncb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#241a06;strokeColor=#e0a030;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• High availability (~99.99% uptime)&lt;br&gt;• Low latency (&lt;200ms manifest, &lt;2s start)&lt;br&gt;• Scale to 250M+ users, 20M+ concurrent streams&lt;br&gt;• Global multi-region + edge CDN&lt;br&gt;• Durability — zero data loss&lt;br&gt;• Strong consistency for billing&lt;br&gt;• DRM + encrypted streams + token auth" vertex="1">
          <mxGeometry height="234" width="615" x="715" y="188" as="geometry" />
        </mxCell>
        <mxCell id="estimateh" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#12281a;strokeColor=#5fc768;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Estimation / Capacity Planning" vertex="1">
