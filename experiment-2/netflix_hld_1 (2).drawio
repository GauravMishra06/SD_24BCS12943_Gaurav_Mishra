        <mxCell id="funcb" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#152238;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=12;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="• Signup / login + multi-profile accounts&lt;br&gt;• Browse &amp; search content catalog&lt;br&gt;• Adaptive-bitrate video streaming&lt;br&gt;• Resume playback across devices&lt;br&gt;• Personalized recommendations&lt;br&gt;• Ratings &amp; reviews&lt;br&gt;• Subscription &amp; billing management&lt;br&gt;• Offline downloads" vertex="1">
