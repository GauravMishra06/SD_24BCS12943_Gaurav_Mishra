        <mxCell id="h3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0f1a2c;strokeColor=#4d84c9;fontColor=#ffffff;fontSize=14;align=center;valign=middle;strokeWidth=1.5;spacing=8;fontStyle=1;arcSize=10;" value="Auth &amp; Profiles" vertex="1"><mxGeometry height="44" width="760.0" x="40" y="130" as="geometry" /></mxCell>
        <mxCell id="b4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1a1a26;strokeColor=#4d84c9;fontColor=#e8e8ee;fontSize=11;align=left;valign=top;strokeWidth=1.5;spacing=10;arcSize=6;" value="&lt;font color=&quot;#4caf50&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/auth/signup&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Create a new account&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4caf50&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/auth/login&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Email/password or SSO login → JWT+refresh&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4caf50&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/auth/refresh&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Exchange refresh token for new access token&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4caf50&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/auth/logout&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Revoke session/refresh token&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4d84c9&quot;&gt;&lt;b&gt;GET&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/profiles&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;List profiles under an account&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#4caf50&quot;&gt;&lt;b&gt;POST&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/profiles&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Create a new viewing profile&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#e0a030&quot;&gt;&lt;b&gt;PUT&lt;/b&gt;&lt;/font&gt;  &lt;tt&gt;/v1/profiles/{id}&lt;/tt&gt;&lt;br&gt;&lt;span style=&quot;color:#9a9aac;font-size:10px&quot;&gt;Update profile (name, avatar, maturity)&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;font color=&quot;#e05050&quot;&gt;&lt;b&gt;DELETE&lt;/b&gt;&lt;/